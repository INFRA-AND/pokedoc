<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>포켓몬 도감 - 2025 NEW 시즌4</title>
    <script src="https://html2canvas.hertzen.com/dist/html2canvas.min.js"></script>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --card-collected: #334155;
            --text-color: #f8fafc;
            --accent: #38bdf8;       /* 시즌4용 시그니처 아이스 블루 */
            --sub-accent: #2563eb;   /* 링크 공유 및 일반 포인트 블루 */
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
            padding: 40px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        /* 헤더 및 타이틀 스타일 */
        header {
            text-align: center;
            width: 100%;
            max-width: 1040px;
        }

        h1 {
            font-size: 3rem;
            margin-bottom: 10px;
            color: var(--accent);
            text-shadow: 0 0 10px rgba(56, 189, 248, 0.2);
        }

        .release-date {
            font-size: 1.2rem;
            color: #94a3b8;
            margin-bottom: 15px;
        }

        /* [★요청] 추가 안내 문구 스타일 - 적당한 크기 조절 */
        .info-note {
            font-size: 0.95rem;
            color: #cbd5e1;
            margin-bottom: 40px;
            font-weight: 500;
            letter-spacing: 0.5px;
            background: rgba(30, 41, 59, 0.6);
            padding: 8px 16px;
            border-radius: 15px;
            display: inline-block;
            border: 1px solid rgba(56, 189, 248, 0.1);
        }

        /* 네비게이션 버튼 레이아웃 */
        .btn-container {
            margin: 0 auto 30px auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            max-width: 1040px;
        }

        .btn-group {
            display: flex;
            gap: 15px;
        }

        .btn {
            color: white;
            border: none;
            padding: 12px 25px;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 25px;
            cursor: pointer;
            transition: 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        /* [★약속] 메인 홈 이동 버튼 */
        .home-btn {
            background-color: #475569;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }
        .home-btn:hover {
            transform: scale(1.05);
            background-color: #334155;
        }

        .download-btn {
            background-color: var(--accent);
            color: #0f172a;
            box-shadow: 0 4px 15px rgba(56, 189, 248, 0.3);
        }
        .download-btn:hover {
            transform: scale(1.05);
            background-color: #0ea5e9;
            color: white;
        }

        .share-btn {
            background-color: var(--sub-accent);
            box-shadow: 0 4px 15px rgba(37, 99, 235, 0.4);
        }
        .share-btn:hover {
            transform: scale(1.05);
            background-color: #1d4ed8;
        }

        /* 도감 캡처 메인 영역 (6칸 그리드) */
        #capture-area {
            width: 100%;
            max-width: 1040px;
            background-color: var(--bg-color);
            padding: 30px;
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
        }

        .grid-container {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 20px;
            width: 100%;
            margin-top: 10px;
        }

        /* 개별 스티커 카드 디자인 및 가로세로 비율 방어 기법 */
        .sticker-card {
            background: #ffffff;      /* 흰색 배경 상시 유지 */
            border: 1px solid #111111; /* 검은색 테두리 박스 고정 */
            border-radius: 8px;
            padding: 8px;
            cursor: pointer;
            transition: 0.2s;
            aspect-ratio: 1 / 1;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .sticker-card img {
            width: 100%;
            height: 100%;
            object-fit: contain;      /* 가로/세로 찌그러짐 방지 원천 차단 */
            display: block;
            transition: 0.2s;
            opacity: 0.25;            /* 미수집 상태: 캐릭터만 흐리게 처리 */
        }

        /* 수집 완료(클릭됨) 상태 */
        .sticker-card.collected {
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.4);
            border: 2px solid var(--accent); /* 수집 시 테두리에 하이라이트 */
        }

        .sticker-card.collected img {
            opacity: 1 !important;    /* 수집 시 캐릭터 본래 색감 복원 */
        }

        /* [★약속] 제작자 표시 낙관 스타일 (캡처 박스 내 우측 하단 고정) */
        .watermark {
            align-self: flex-end;
            margin-top: 50px;
            font-size: 0.85rem;
            color: #475569;
            font-weight: bold;
            letter-spacing: 2px;
            text-shadow: 1px 1px 0px rgba(0,0,0,0.5);
        }
    </style>
</head>
<body>

    <div class="btn-container">
        <a href="../index.html" class="btn home-btn">🏠 메인 목록으로</a>
        <div class="btn-group">
            <button class="btn download-btn" onclick="downloadDoc()">내 도감 이미지 저장</button>
            <button class="btn share-btn" onclick="copyShareLink()">현재 도감 링크 복사</button>
        </div>
    </div>

    <div id="capture-area">
        <header>
            <h1>2025 NEW 시즌4 띠부씰 도감</h1>
            <div class="release-date">출시일: 2025년 07월 31일</div>
            <div class="info-note">2025년 7월 31일 출시 NEW 시즌4 168종</div>
        </header>

        <div class="grid-container" id="grid-container"></div>

        <div class="watermark">CREATED BY AND</div>
    </div>

    <script>
        const total = 168; // 총 종수 명시
        const storageKey = 'pokedoc_2025_new_season4'; // 고유 저장소 키값

        const grid = document.getElementById('grid-container');
        const urlParams = new URLSearchParams(window.location.search);
        const codeParam = urlParams.get('code');

        let collected = [];

        // URL 파라미터 혹은 로컬스토리지 연동 데이터를 기반으로 수집 데이터 복원
        if (codeParam) {
            collected = codeParam.split(',').map(Number).filter(n => n > 0 && n <= total);
        } else {
            collected = JSON.parse(localStorage.getItem(storageKey)) || [];
        }

        // 도감 그리드 스티커 판 동적 자동 빌드 생성
        for (let i = 1; i <= total; i++) {
            const card = document.createElement('div');
            card.className = 'sticker-card';
            card.setAttribute('data-id', i);

            if (collected.includes(i)) {
                card.classList.add('collected');
            }

            // [★핵심] 파일 개수 제약 우회를 위한 100개 단위 폴더 분기 엔진 적용
            // 1 ~ 100번은 '1' 폴더, 101 ~ 168번은 '2' 폴더로 자동 조절 매핑
            let folderNum = i <= 100 ? "1" : "2";

            const img = document.createElement('img');
            // 요청 요건(경로 주소, 폴더 트리 구조, png 확장자) 완벽 동기화
            img.src = `../image/2025_new_season4/${folderNum}/${i}.png`;
            img.alt = `시즌4 스티커 ${i}`;
            img.crossOrigin = "anonymous"; // html2canvas 캡처 시 이미지 보호 및 CORS 방어

            card.appendChild(img);

            // 클릭 이벤트 매핑 (토글 토크 나이트 모듈 작동)
            card.onclick = () => {
                card.classList.toggle('collected');
                updateStorage(i);
                updateURL();
            };

            grid.appendChild(card);
        }

        // 로컬 브라우저 수첩 저장 기능
        function updateStorage(id) {
            const index = collected.indexOf(id);
            if (index > -1) {
                collected.splice(index, 1);
            } else {
                collected.push(id);
            }
            localStorage.setItem(storageKey, JSON.stringify(collected));
        }

        // 주소창 뒤 파라미터 실시간 매핑 함수 (?code=1,5,9...)
        function updateURL() {
            if (collected.length > 0) {
                const sortedCollected = [...collected].sort((a, b) => a - b);
                const newUrl = `${window.location.protocol}//${window.location.host}${window.location.pathname}?code=${sortedCollected.join(',')}`;
                window.history.replaceState({ path: newUrl }, '', newUrl);
            } else {
                const cleanUrl = `${window.location.protocol}//${window.location.host}${window.location.pathname}`;
                window.history.replaceState({ path: cleanUrl }, '', cleanUrl);
            }
        }

        // 카카오톡 등 타인에게 전송하기 위한 간편 클립보드 복사 모듈
        function copyShareLink() {
            updateURL();
            navigator.clipboard.writeText(window.location.href).then(() => {
                alert('2025 NEW 시즌4 도감 수집 현황이 담긴 공유 링크가 복사되었습니다!');
            }).catch(err => {
                alert('링크 복사에 실패했습니다. 주소창의 주소를 직접 복사해주세요.');
            });
        }

        // html2canvas 기반 커스텀 낙관 및 필터 보존 고화질 이미지 캡처 다운로드 모듈
        function downloadDoc() {
            const target = document.getElementById('capture-area');
            html2canvas(target, {
                useCORS: true,
                allowTaint: true,
                backgroundColor: "#0f172a", // 테마와 맞춘 어두운 단색 배경 고정 지정
                scale: 2 // 스마트폰 고해상도 환경 대응 배율 강화
            }).then(canvas => {
                const link = document.createElement('a');
                link.download = '내_2025_NEW_시즌4_도감.png';
                link.href = canvas.toDataURL('image/png');
                link.click();
            });
        }

        if (!codeParam && collected.length > 0) {
            updateURL();
        }
    </script>
</body>
</html>
